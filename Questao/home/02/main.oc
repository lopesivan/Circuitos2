% main.oc - a
% Maintainer: Ivan Lopes

j = 1i; % unidade imaginária em MATLAB

V1 = to_rd(8, 50)  % <8, 50°>
w  = 1E3
L  = 50E-3
C  = 2E-6

XL = L*w
XC = 1/(C*w)
R1 = 4E3
R2 = 2E3
ZC = -j*XC
ZL = j*XL


A = [
	(R1+ZC), -ZC
    R2/2-ZC , R2/2+(ZC+ZL)
]

B = [
	V1
    0
]

S = A\B
X = S(1,1)
Y = S(2,1)
Z = (X+Y)/2
Vo= R2*Z
Io= X-Y
disp("------------------")
disp("resposta:")
disp("------------------")
disp("")

X  = to_pd(X)           % polar display
Y  = to_pd(Y)
Z  = to_pd(Z)
Vo = to_pd(Vo)
Io = to_pd(Io)

X = S(1,1)
Y = S(2,1)
VC = (X-Y)*ZC
VC = to_pd(VC)

