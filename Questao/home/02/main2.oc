% main.oc - a
% Maintainer: Ivan Lopes

j = 1i; % unidade imaginária em MATLAB

V1 = to_rd(8, 50)  % <8, 50°>
w  = 1E3
L  = 50E-3
C  = 2E-6

XL = L*w
XC = 1/(C*w)
R1 = 4E3
R2 = 2E3
ZC = -j*XC
ZL = j*XL

k1=-R2/2
k2=R2/2
A = [
	(R1+ZC), -ZC
    -k1-ZC , -k2+(R2+ZC+ZL)
]

B = [
	V1
    0
]


disp("------------------")
disp("resposta:")
disp("------------------")
disp("")
S = A\B;
X = S(1,1);
Y = S(2,1);
Z = (X-Y)/2;
Vo= R2*(Z+Y);

Vo = to_pd(Vo)


