% main.oc - a
% Maintainer: Ivan Lopes

j = 1i; % unidade imaginária em MATLAB

V1 = to_rd(24, 0)
I1 = to_rd(2, -90)
I2 = to_rd(4, 0)

w  = 8
L  = 1/4
C  = 1/32

XL = L*w
XC = 1/(C*w)
R1 = 4
R2 = 2
ZC = -j*XC
ZL = j*XL

k1=2*ZL
k2=-2*ZL

A = [
	(R1+R2+ZC),     -R1
	     -k1-R1, -k2+(R1+ZL)
]

B = [
    I1*R2
	V1
]

S = A\B
x = S(1,1)
y = S(2,1)
Vo= x*ZC

disp("------------------")
disp("resposta:")
disp("------------------")
disp("")
Vo = to_pd(Vo)           % polar display

%X  = to_pd(X)           % polar display

